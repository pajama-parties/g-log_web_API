# ── 앱 ──
# auth 서버(backend)가 3000을 쓰므로 3001
PORT=3001

# ── PostgreSQL ── backend/docker-compose.yml 의 glog-postgres 컨테이너를 같이 씀 (backend 폴더에서 npm run db:up)
# backend/.env 와 같은 값을 넣으세요. 스키마·테이블(마이그레이션)은 backend 에서 관리합니다.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=glog
DB_PASSWORD=change-me
# DB 하나에 스키마 두 개 (auth / service)
DB_NAME=glog

# SQL 로그 출력 (true / false)
DB_LOGGING=false

# ── JWT ── backend/.env 의 JWT_ACCESS_SECRET 과 반드시 같은 값
# auth 서버가 서명한 access 토큰을 이 서버는 검증만 합니다.
JWT_ACCESS_SECRET=change-me-access

# ── 사진 업로드 ── 커뮤니티 글 사진을 저장할 폴더 (기본: 서버를 실행한 폴더의 uploads/). /api/uploads/ 주소로 공개됨
# UPLOAD_DIR=uploads
